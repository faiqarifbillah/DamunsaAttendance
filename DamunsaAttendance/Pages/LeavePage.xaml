<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DamunsaAttendance.Pages.LeavePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F0F4FF"
    Title="Leave Request"
    Shell.NavBarIsVisible="False"
    Padding="0">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Top Banner -->
            <Grid BackgroundColor="#1E3A8A" Padding="20,40,20,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Apply Leave"
                           FontSize="26" FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="Submit a leave request for approval"
                           FontSize="13" TextColor="#93C5FD"/>
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Logout"
                        Clicked="OnLogoutClicked"
                        BackgroundColor="Transparent"
                        TextColor="#93C5FD"
                        BorderColor="#93C5FD"
                        BorderWidth="1"
                        CornerRadius="20"
                        FontSize="12"
                        Padding="14,6"
                        VerticalOptions="Center"/>
            </Grid>

            <!-- Balance -->
            <Border BackgroundColor="#DBEAFE"
                    Stroke="#93C5FD" StrokeThickness="1"
                    Margin="20,-14,20,0"
                    Padding="16,12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Label x:Name="AnnualBalanceLabel"
                       Text="Annual Leave Balance: 20 days remaining"
                       FontSize="14" FontAttributes="Bold"
                       TextColor="#1E40AF"/>
            </Border>

            <!-- Form -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0" StrokeThickness="1"
                    Margin="20,16,20,20"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="20">

                    <!-- Leave Type -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Leave Type"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#1E293B"/>
                        <Grid ColumnSpacing="10" RowSpacing="10"
                              ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto">
                            <Button x:Name="AnnualLeaveBtn"
                                    Grid.Row="0" Grid.Column="0"
                                    Text="Annual Leave"
                                    Clicked="OnAnnualLeaveClicked"
                                    HeightRequest="48" CornerRadius="12"
                                    BackgroundColor="White" BorderColor="#CBD5E1"
                                    BorderWidth="1.5" TextColor="#64748B" FontSize="13"/>
                            <Button x:Name="SickLeaveBtn"
                                    Grid.Row="0" Grid.Column="1"
                                    Text="Sick Leave"
                                    Clicked="OnSickLeaveClicked"
                                    HeightRequest="48" CornerRadius="12"
                                    BackgroundColor="White" BorderColor="#CBD5E1"
                                    BorderWidth="1.5" TextColor="#64748B" FontSize="13"/>
                            <Button x:Name="EmergencyLeaveBtn"
                                    Grid.Row="1" Grid.Column="0"
                                    Text="Emergency"
                                    Clicked="OnEmergencyLeaveClicked"
                                    HeightRequest="48" CornerRadius="12"
                                    BackgroundColor="White" BorderColor="#CBD5E1"
                                    BorderWidth="1.5" TextColor="#64748B" FontSize="13"/>
                            <Button x:Name="UnpaidLeaveBtn"
                                    Grid.Row="1" Grid.Column="1"
                                    Text="Unpaid Leave"
                                    Clicked="OnUnpaidLeaveClicked"
                                    HeightRequest="48" CornerRadius="12"
                                    BackgroundColor="White" BorderColor="#CBD5E1"
                                    BorderWidth="1.5" TextColor="#64748B" FontSize="13"/>
                        </Grid>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#F1F5F9"/>

                    <!-- Duration -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Duration"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#1E293B"/>
                        <Grid ColumnSpacing="10" ColumnDefinitions="*,*">
                            <Button x:Name="FullDayBtn"
                                    Grid.Column="0" Text="Full Day"
                                    Clicked="OnFullDay"
                                    HeightRequest="48" CornerRadius="12"
                                    BackgroundColor="White" BorderColor="#CBD5E1"
                                    BorderWidth="1.5" TextColor="#64748B" FontSize="13"/>
                            <Button x:Name="HalfDayBtn"
                                    Grid.Column="1" Text="Half Day"
                                    Clicked="OnHalfDay"
                                    HeightRequest="48" CornerRadius="12"
                                    BackgroundColor="White" BorderColor="#CBD5E1"
                                    BorderWidth="1.5" TextColor="#64748B" FontSize="13"/>
                        </Grid>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#F1F5F9"/>

                    <!-- Leave Period -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Leave Period"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#1E293B"/>
                        <Grid ColumnSpacing="12" ColumnDefinitions="*,*">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Start Date" FontSize="12" TextColor="#94A3B8"/>
                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0"
                                        StrokeThickness="1" Padding="10,6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <DatePicker x:Name="StartDatePicker"
                                                Format="dd/MM/yyyy"
                                                TextColor="#1E293B"
                                                BackgroundColor="Transparent"
                                                FontSize="14"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="End Date" FontSize="12" TextColor="#94A3B8"/>
                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0"
                                        StrokeThickness="1" Padding="10,6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <DatePicker x:Name="EndDatePicker"
                                                Format="dd/MM/yyyy"
                                                TextColor="#1E293B"
                                                BackgroundColor="Transparent"
                                                FontSize="14"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <Border BackgroundColor="#F0FDF4" Stroke="#BBF7D0"
                                StrokeThickness="1" Padding="12,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label x:Name="DaysLabel"
                                   Text="Estimated days: 1"
                                   FontSize="13" TextColor="#166534"/>
                        </Border>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#F1F5F9"/>

                    <!-- Reason -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Reason (Compulsory)"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#1E293B"/>
                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0"
                                StrokeThickness="1" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Editor x:Name="ReasonEntry"
                                    Placeholder="Enter your reason here..."
                                    PlaceholderColor="#CBD5E1"
                                    AutoSize="TextChanges"
                                    FontSize="14"
                                    HeightRequest="100"
                                    TextColor="#1E293B"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Submit -->
                    <Button Text="Submit Request"
                            Clicked="OnSubmitClicked"
                            HeightRequest="52" CornerRadius="16"
                            BackgroundColor="#1E3A8A" TextColor="White"
                            FontAttributes="Bold" FontSize="16"
                            Margin="0,4,0,0"/>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
